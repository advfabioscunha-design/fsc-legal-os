# FSC LEGAL OS v4 — copiar para .env na VPS e preencher
AMBIENTE=prod
ADVOGADO_NOME=Fábio Silva Cunha
OAB=OAB/RO 10.849
EMAIL_ESCRITORIO=adv.fabios.cunha@gmail.com

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_RAPIDO=claude-haiku-4-5-20251001

ASAAS_API_KEY=
ZAPSIGN_API_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
HUMANO_WHATSAPP=5569XXXXXXXXX
LINK_AGENDA=https://cal.com/fabiocunha

# ── Dois números do escritório (roteamento pelo DDD do cliente) ──
# Cliente DDD 69 → responde o número de Rondônia
# Cliente DDD 48 → responde o número de Santa Catarina
# Qualquer outro DDD (ou sem telefone) → responde sempre o 48
WHATSAPP_PHONE_ID_69=          # Phone Number ID do (69) 99322-5383 no painel do Meta
WHATSAPP_PHONE_ID_48=          # Phone Number ID do (48) 98835-7992 no painel do Meta
WHATSAPP_NUMERO_69=5569993225383
WHATSAPP_NUMERO_48=5548988357992
WHATSAPP_DDD_PADRAO=48

# ── E-mail dos avisos (Gmail com SENHA DE APP) ───────────────────
# Gere em: myaccount.google.com → Segurança → Verificação em duas etapas
#          → Senhas de app → "FSC Legal OS". Cole os 16 caracteres abaixo.
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=adv.fabios.cunha@gmail.com
SMTP_SENHA=
SMTP_REMETENTE=FC Advocacia

# ── Caixa de entrada: recebe a via assinada devolvida por e-mail ─
# Usa a MESMA senha de app do Gmail. No Gmail, IMAP já vem habilitado.
IMAP_HOST=imap.gmail.com
IMAP_PORTA=993
IMAP_PASTA=INBOX
IMAP_AUTO=true
IMAP_MINUTOS=10

# Painel do cliente (link usado nos avisos)
APP_URL=https://app.fscadvocaciadigital.com.br
# Lembrete automático de quem não deu ciência
AVISO_LEMBRETE_HORAS=24
AVISO_LEMBRETES_MAX=3

# ── Voz do agente (áudio WhatsApp) ───────────────────────────
# STT (transcrição dos áudios do cliente): OpenAI Whisper API
OPENAI_API_KEY=
# (sem OPENAI_API_KEY, usa faster-whisper local na VPS)
WHISPER_MODELO=small
# TTS (voz clonada do Dr. Fábio Cunha): ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Aviso de assistente digital na 1ª mensagem (transparência/OAB)
AVISO_ASSISTENTE=true

REDIS_URL=redis://redis:6379/0
RPA_HEADLESS=true
EPROC_TJSC_LOGIN=
EPROC_TJSC_SENHA=
PJE_TJRO_LOGIN=
PJE_TJRO_SENHA=
PJE_TRT14_LOGIN=
PJE_TRT14_SENHA=

# ── Radar Jurimétrico (DataJud / CNJ) ────────────────────────
# Chave pública oficial do CNJ (já embutida como padrão no código;
# preencha só se o CNJ trocar a chave). Wiki: datajud-wiki.cnj.jus.br
DATAJUD_API_KEY=
# Tribunais de atuação (aliases DataJud, separados por vírgula)
DATAJUD_TRIBUNAIS=tjro,trt14
# Agendamento automático do radar semanal
RADAR_AUTO=true
RADAR_DIA_SEMANA=mon
RADAR_HORA=6

# ── Pesquisa de jurisprudência (ementas para a petição) ──────────
# O DataJud do CNJ não devolve ementa. Para o agente de precedentes citar
# julgado real é preciso um provedor de pesquisa. Gere o token gratuito em
# jurisprudencias.ai/api-tokens (5 buscas/dia; R$ 59,90/mês para 500/dia).
JURISPRUDENCIA_PROVEDOR=JURISPRUDENCIAS
JURISPRUDENCIAS_API_TOKEN=
JUSBRASIL_API_TOKEN=

# ── Atendimento telepresencial (Daily.co) ────────────────────────
# Vídeo ao vivo; grava SOMENTE o áudio (cloud-audio-only).
# Chave em dashboard.daily.co → Developers. A gravação exige cartão
# cadastrado (contas novas ganham US$ 15 de crédito).
DAILY_API_KEY=
# Segredo do webhook de "gravação pronta". Sem ele, qualquer um poderia
# postar no endpoint e injetar áudio no acervo do escritório.
DAILY_WEBHOOK_SEGREDO=
